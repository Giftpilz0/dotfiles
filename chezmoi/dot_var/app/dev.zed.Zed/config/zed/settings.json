{
  "ui_font_family": "Google Sans Flex",
  "buffer_font_family": "Maple Mono",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "use_system_path_prompts": false,
  "redact_private_values": false,
  "private_files": [
    "**/.env*",
    "**/*.pem",
    "**/*.key",
    "**/*.cert",
    "**/*.crt",
    "**/secrets.yml"
  ],
  "title_bar": {
    "show_sign_in": false
  },
  "agent": {
    "default_model": {
      "provider": "LiteLLM",
      "model": "Qwen3-Coder"
    },
    "enable_feedback": false,
    "default_profile": "code",
    "profiles": {
      "code": {
        "name": "code",
        "tools": {
          "project_notifications": true,
          "delete_path": true,
          "move_path": true,
          "thinking": true,
          "terminal": false,
          "read_file": true,
          "open": true,
          "now": true,
          "list_directory": true,
          "grep": true,
          "find_path": true,
          "fetch": true,
          "edit_file": true,
          "diagnostics": true,
          "create_directory": true,
          "copy_path": true
        },
        "enable_all_context_servers": true,
        "context_servers": {}
      }
    },
    "model_parameters": [
      // {
      //   "provider": "openai",
      //   "model": "ollama/devstral:latest",
      //   "temperature": 1.0
      // }
    ]
  },
  "tabs": {
    "file_icons": true
  },
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "on",
  "formatter": "auto",
  "helix_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "language_models": {
    "openai_compatible": {
      "LiteLLM": {
        "api_url": "",
        "available_models": [
          {
            "name": "Qwen3-Coder",
            "display_name": "Qwen3-Coder-30B-A3B-Instruct-FP8",
            "max_tokens": 110000
          }
        ]
      }
    }
  }
}
