{{- if and (eq .chezmoi.os "linux") (not (env "CHEZMOI_SKIP_ONLINE_DOWNLOADS")) }}
{{- $yazi := "https://github.com/sxyazi/yazi/releases/latest/download/yazi-x86_64-unknown-linux-gnu.zip" }}
[".local/bin/yazi"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    stripComponents = 1
    path = "yazi"
    executable = true
    refreshPeriod = "168h"

[".local/bin/ya"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    stripComponents = 1
    path = "ya"
    executable = true
    refreshPeriod = "168h"

[".local/share/bash-completion/completions/yazi"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    stripComponents = 1
    path = "completions/yazi.bash"
    refreshPeriod = "168h"

[".local/share/bash-completion/completions/ya"]
    type = "archive-file"
    url = {{ $yazi | quote }}
    stripComponents = 1
    path = "completions/ya.bash"
    refreshPeriod = "168h"

[".local/bin/sysutil"]
    type = "archive-file"
    url = "https://github.com/Giftpilz0/sysutil/releases/latest/download/sysutil_linux_amd64.tar.gz"
    path = "sysutil"
    executable = true
    refreshPeriod = "168h"

{{- if get . "razer" }}
[".local/bin/razerctl"]
    type = "archive-file"
    url = "https://github.com/Giftpilz0/razerctl/releases/latest/download/razerctl_linux_amd64.tar.gz"
    path = "razerctl"
    executable = true
    refreshPeriod = "168h"
{{- end }}

{{- if ne .chezmoi.username "root" }}
# Shared guidelines, imported by ~/.claude/CLAUDE.md
[".local/share/giftpilz0-shared"]
    type = "git-repo"
    url = "https://github.com/Giftpilz0/shared.git"
    refreshPeriod = "168h"

[".local/share/fonts/Maple Mono"]
    type = "archive"
    url = "https://github.com/subframe7536/maple-font/releases/latest/download/MapleMono-Variable.zip"
    refreshPeriod = "168h"

[".local/share/fonts/Maple Mono NF"]
    type = "archive"
    url = "https://github.com/subframe7536/maple-font/releases/latest/download/MapleMono-NF.zip"
    refreshPeriod = "168h"
{{- end }}
{{- end }}
