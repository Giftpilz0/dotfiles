{{- $name := promptStringOnce . "name" "Git user.name" -}}
{{- $email := promptStringOnce . "email" "Git user.email" -}}
{{- $peripheralctl := promptBoolOnce . "peripheralctl" "Install peripheralctl (Razer mice and VIA keyboards)" false -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    peripheralctl = {{ $peripheralctl }}
