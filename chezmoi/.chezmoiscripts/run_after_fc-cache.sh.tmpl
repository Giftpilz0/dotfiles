{{ if ne .chezmoi.username "root" -}}
#!/usr/bin/env bash
# Rebuild font cache after dotfiles apply
set -euo pipefail

# ── guards ────────────────────────────────────────────────────────────────────

command -v gum      >/dev/null 2>&1 || exit 0
command -v fc-cache >/dev/null 2>&1 || exit 0

# ── main ──────────────────────────────────────────────────────────────────────

gum spin --spinner dot --title "Rebuilding font cache…" -- \
    fc-cache -f "${HOME}/.local/share/fonts"

gum log --level info "Font cache rebuilt."
{{ end -}}
