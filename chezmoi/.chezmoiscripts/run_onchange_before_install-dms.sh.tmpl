#!/usr/bin/env bash
{{ if ne .chezmoi.username "root" -}}
set -euo pipefail

if command -v dms >/dev/null 2>&1; then
    echo "DMS already installed, skipping"
    exit 0
fi

if [[ -f /run/ostree-booted ]]; then
    if ! command -v rpm-ostree >/dev/null 2>&1; then
        echo "rpm-ostree not found; cannot install DMS on this ostree system" >&2
        exit 1
    fi
    echo "Silverblue detected — layering DMS via rpm-ostree (a reboot will be required)"
    rpm-ostree copr enable -y avengemedia/dms
    rpm-ostree install -y dms
    echo "DMS layered successfully. Please reboot to apply the changes."
else
    sudo dnf copr enable -y avengemedia/dms
    sudo dnf install -y dms
fi
{{ else -}}
exit 0
{{ end -}}
